# Копия в .env не обязательна: у каждой переменной есть демо-значение по умолчанию.
# Для любого запуска дальше локальной демонстрации поменяйте пароли и токены.

HTTP_PORT=8080
PUBLIC_URL=http://localhost:8080
COOKIE_SECURE=false

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ANALYST_USERNAME=analyst
ANALYST_PASSWORD=analyst

POSTGRES_DB=churn
POSTGRES_USER=churn
POSTGRES_PASSWORD=churn

METRICS_TOKEN=churn-metrics-demo-token

NOTIFIER_REPLICAS=2
SCORING_REPLICAS=2
ALERTS_REPLICAS=2
LOG_LEVEL=info

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# SSO через Authentik: docker compose --profile sso up -d
# Все значения ниже — демо. Для реального запуска смените секреты и пароли.
AUTHENTIK_PORT=9000
AUTHENTIK_SECRET_KEY=churn-radar-demo-authentik-secret-key-change-me-0123456789
AUTHENTIK_DB_PASSWORD=authentik-demo-db
# админка Authentik: http://localhost:9000, логин akadmin
AUTHENTIK_ADMIN_PASSWORD=authentik
# демо-пользователи для входа в панель через Authentik
SSO_DEMO_ADMIN_PASSWORD=admin
SSO_DEMO_MARKETER_PASSWORD=marketer
SSO_DEMO_OUTSIDER_PASSWORD=outsider

# OIDC: браузер ходит на публичный issuer, auth — на внутренний
OIDC_ENABLED=true
OIDC_PUBLIC_ISSUER=http://localhost:9000/application/o/churn-radar/
OIDC_INTERNAL_ISSUER=http://authentik-server:9000/application/o/churn-radar/
OIDC_CLIENT_ID=churn-radar
OIDC_CLIENT_SECRET=churn-radar-demo-secret
OIDC_SCOPES=openid profile email churn-radar
OIDC_DISPLAY_NAME=Войти через Authentik (OIDC)

# SAML: метаданные IdP по URL (или SAML_IDP_METADATA_FILE / SAML_IDP_METADATA_XML)
SAML_ENABLED=true
SAML_IDP_METADATA_URL=http://authentik-server:9000/application/saml/churn-radar-saml/metadata/
SAML_IDP_PUBLIC_URL=http://localhost:9000
SAML_DISPLAY_NAME=Войти через Authentik (SAML)

# группы IdP -> роли панели; пустая роль по умолчанию = без группы входа нет
SSO_ADMIN_GROUPS=churn-admins
SSO_ANALYST_GROUPS=churn-analysts
SSO_DEFAULT_ROLE=

# оповещения (services/alerts): пороги и внешние каналы, пустое значение — канал выключен
ALERT_LOSS_JUMP_EUR=50
ALERT_TOTAL_LOSS_JUMP_PCT=10
ALERT_COOLDOWN_MIN=60
ALERTS_BULK_THRESHOLD=20
ALERTS_WEBHOOK_URL=
ALERTS_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Почта. По умолчанию все письма ловит Mailpit (http://localhost:8025) и никуда не отправляет.
# Для настоящей отправки укажите свой SMTP.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls   # none | starttls | tls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=care@example.com
# SMTP_FROM_NAME=ChurnRadar
# MAILPIT_PORT=8025
